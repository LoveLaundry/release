# LoveLaundry self-hosted backend env.
# Copy to `backend.env` (same directory) and fill real values.
# WARNING: the Docker entrypoint refuses to start if JWT_SECRET is missing or still the default,
# and warns (no refusal) if MASTER_KEY is still the default. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"

# ============ Shared: JWT + encryption + sync ============
JWT_SECRET=CHANGE_ME_48_random_chars
MASTER_KEY=CHANGE_ME_48_random_chars
SYNC_ENABLED=false
ALLOWED_ORIGINS=http://localhost

# ============ bill_service (bills-backend) ============
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=LoveLaundry
MONGO_DB_NAME=bill_db

# ============ quotation-service (quotation-backend) ============
MONGODB_DB_NAME=quotations_db
MONGODB_COLLECTION=quotations
CHAT_BOT_URL=https://your-love-bot.vercel.app
CHAT_API_KEY=

# ============ user-service (user-backend) ============
MONGODB_DB_NAME=users_db
MONGODB_COLLECTION=users

# ============ worker-service (workers-backend) ============
MONGODB_DB_NAME=workers_db
MONGODB_WORKERS_COLLECTION=workers
MONGODB_DAILY_LOGS_COLLECTION=daily_task_logs

# ============ laundry-management (mgmt-backend) ============
MONGODB_MAIN_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=LoveLaundry
MONGODB_MAIN_DB=laundry_management

# ============ love-ai (ai-backend) ============
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=LoveLaundry
MONGO_DB_NAME=laundry_management
LOVE_AI_API_KEYS=CHANGE_ME_ai_key
SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=["http://localhost"]
RATE_LIMIT_PER_MINUTE=120