# Base URL of the chat backend service (the bot/ folder).
# Leave empty to call a co-located API (e.g. a Vercel function at /api/chat).
# Set VITE_CHAT_API_URL to the quotation-service base URL (conversation API).
# The bot service does not expose the /chat/conversations endpoints used by this site.

# Base URL of the quotation-service that serves the public tracking endpoints
# (/tags/{code}/tracking and /quotations/{id}/tracking). Optional: when unset,
# VITE_CHAT_API_URL is reused because it points at the same service.
VITE_TRACKING_API_URL=https://your-quotation-service.vercel.app
