# Optional chat modes. Leave both unset to run the bundled ANN in the browser.
# 1) Hosted conversation service (admin takeover, server-side history).
VITE_CHAT_API_URL=https://your-quotation-service.vercel.app
# 2) Standalone ANN Node server (used only when VITE_CHAT_API_URL is unset).
VITE_BOT_API_URL=http://localhost:8787

# Base URL of the quotation-service that serves the public tracking endpoints
# (/tags/{code}/tracking and /quotations/{id}/tracking). Optional: when unset,
# VITE_CHAT_API_URL is reused because it points at the same service.
VITE_TRACKING_API_URL=https://your-quotation-service.vercel.app
